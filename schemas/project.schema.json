{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://city-ink.local/schemas/project.schema.json",
  "title":"City Ink project v1",
  "type":"object",
  "required":["schemaVersion","name","area","source"],
  "properties":{
    "schemaVersion":{"const":1},"name":{"type":"string","minLength":1,"pattern":"\\S"},
    "area":{"type":"object","required":["south","west","north","east"],"properties":{"south":{"type":"number","minimum":-80,"maximum":80},"north":{"type":"number","minimum":-80,"maximum":80},"west":{"type":"number","minimum":-180,"maximum":180},"east":{"type":"number","minimum":-180,"maximum":180}}},
    "origin":{"type":"object","required":["lat","lon"],"properties":{"lat":{"type":"number","minimum":-80,"maximum":80},"lon":{"type":"number","minimum":-180,"maximum":180}}},
    "seed":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991,"default":1},
    "source":{"type":"object","required":["kind","file"],"properties":{"kind":{"enum":["overpass","osm-map","local","import","sample"]},"file":{"type":"string","minLength":1,"pattern":"\\S"},"provider":{"enum":["overpass-main","private-coffee","vk-maps","dresel-europe","custom"],"description":"Optional preset supplies endpoint and transport. Explicit endpoint/transport can override it. custom requires an endpoint."},"endpoint":{"$ref":"#/$defs/overpassEndpoint"},"transport":{"enum":["post","get"],"description":"Explicit override; otherwise the provider transport, or post for the built-in default."},"fallbackEndpoints":{"type":"array","maxItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/overpassEndpoint"},"default":[]},"fallbackPolicy":{"enum":["none","unavailable"],"default":"none","description":"Only explicit unavailable fallback. Never rotate on 429/406, invalid data or cancellation."}},"allOf":[{"if":{"properties":{"provider":{"const":"custom"}},"required":["provider"]},"then":{"required":["endpoint"]}}]},
    "generation":{"type":"object","properties":{"landscapeEnabled":{"type":"boolean","default":false},"inferRoofs":{"type":"boolean","default":false}}},
    "tiling":{"type":"object","properties":{"sizeMeters":{"type":"number","minimum":25,"maximum":10000,"default":500},"divisions":{"type":"integer","minimum":1,"maximum":32,"description":"Optional N by N fixed-area comparison grid; overrides sizeMeters."}}},
    "quality":{"enum":["draft","low","balanced","high"],"default":"balanced"},
    "style":{"type":"object","required":["id"],"additionalProperties":false,"properties":{"id":{"type":"string","minLength":1,"pattern":"\\S"},"parameters":{"type":"object","default":{}},"entry":{"type":"string","minLength":1,"description":"Project-relative ESM .js/.mjs/.ts entry exporting a StylePack; DOM work belongs inside factories.","pattern":"^(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\:\\u0000]+(?:/[^/\\\\:\\u0000]+)*\\.(m?js|ts)$"},"dependencies":{"type":"object","propertyNames":{"pattern":"^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!(?:three(?:/|$)|beijing-city-ink(?:/|$)))(?:@[\\w-]+/)?[\\w-]+(?:/[\\w.-]+)*$"},"additionalProperties":{"type":"string","pattern":"^(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\:\\u0000]+(?:/[^/\\\\:\\u0000]+)*$"},"description":"Explicit bare import specifier to project-relative module file. Three.js and beijing-city-ink/styles are engine-provided."},"assets":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\:\\u0000]+(?:/[^/\\\\:\\u0000]+)*$"},"description":"Project-relative imported images/fonts/binary assets; bundled locally."}},"dependentRequired":{"dependencies":["entry"],"assets":["entry"]}},
    "camera":{"type":"object","properties":{"position":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}},"target":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}},"fov":{"type":"number","minimum":5,"maximum":140},"near":{"type":"number","exclusiveMinimum":0}}},
    "landmarks":{"type":"object","properties":{"enabled":{"type":"boolean","default":true},"policy":{"enum":["strict","degraded"]},"packages":{"type":"array","items":{"oneOf":[{"type":"string"},{"type":"object","required":["path"],"properties":{"path":{"type":"string"},"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"recipes":{"type":"array","items":{"type":"object","required":["id","version"],"properties":{"id":{"type":"string"},"version":{"type":"string"}}}}}}]},"default":[]}}}
  },
  "$defs":{"overpassEndpoint":{"type":"string","minLength":1,"maxLength":2048,"pattern":"^https?://[^/?#@\\s]+(?:/[^?#\\s]*)?$","description":"Full HTTP(S) interpreter URL; no credentials, query or fragment. HTTP permits local self-hosted services. Runtime additionally canonicalizes URLs and rejects duplicate primary/fallback endpoints."}},
  "$comment":"Runtime validation additionally rejects unordered/date-line areas, spans over 10 km, origins outside the project, and grids over 4096 cells. This is a finite local projection build limit, not a browser support promise. Persist the initialized origin."
}
