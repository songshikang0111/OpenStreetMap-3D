{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://city-ink.local/schemas/scene.schema.json",
  "title": "City Ink deterministic scene manifest v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "generator",
    "origin",
    "coordinateSystem",
    "bounds",
    "sources",
    "attribution",
    "styleContractVersion",
    "chunks",
    "featureIndex"
  ],
  "$defs": {
    "bounds": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "number"
      }
    },
    "lod": {
      "type": "object",
      "required": [
        "id",
        "level",
        "uri",
        "hash",
        "bytes",
        "residentBytes",
        "triangles",
        "drawCalls",
        "bounds",
        "geometricError",
        "selection"
      ],
      "properties": {
        "id": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "level": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "uri": {
          "type": "string",
          "pattern": "^chunks/[a-zA-Z0-9_.-]+\\.cink$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "residentBytes": {
          "type": "integer",
          "minimum": 0
        },
        "triangles": {
          "type": "integer",
          "minimum": 0
        },
        "drawCalls": {
          "type": "integer",
          "minimum": 0
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "geometricError": {
          "type": "number",
          "minimum": 0
        },
        "selection": {
          "type": "object",
          "required": [
            "metric",
            "geometricErrorMeters",
            "maxScreenSpaceError"
          ],
          "properties": {
            "metric": {
              "const": "screen-space-error"
            },
            "geometricErrorMeters": {
              "type": "number",
              "minimum": 0
            },
            "maxScreenSpaceError": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "drawUnits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "bounds",
              "triangles",
              "drawCalls"
            ],
            "properties": {
              "bounds": {
                "$ref": "#/$defs/bounds"
              },
              "triangles": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "drawCalls": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "shadowTriangles": {
                "type": "integer",
                "minimum": 0
              },
              "shadowDrawCalls": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "description": "Optional per-mesh bounds within LOD bounds; cost sums must equal complete LOD costs (runtime validator)."
        },
        "shadowTriangles": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional exact submitted caster triangles before shadow-frustum culling."
        },
        "shadowDrawCalls": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generator": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "origin": {
      "type": "object",
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        }
      }
    },
    "coordinateSystem": {
      "type": "object",
      "required": [
        "crs",
        "axes",
        "units",
        "projection"
      ],
      "properties": {
        "units": {
          "const": "meters"
        },
        "axes": {
          "type": "object",
          "properties": {
            "x": {
              "const": "east"
            },
            "y": {
              "const": "up"
            },
            "z": {
              "const": "south"
            }
          },
          "required": [
            "x",
            "y",
            "z"
          ]
        }
      }
    },
    "bounds": {
      "$ref": "#/$defs/bounds"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "attribution": {
      "type": "object",
      "required": [
        "text",
        "license"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "styleContractVersion": {
      "const": 1
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "contentBounds",
          "transform",
          "lods"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "contentBounds": {
            "$ref": "#/$defs/bounds"
          },
          "transform": {
            "type": "array",
            "minItems": 16,
            "maxItems": 16,
            "items": {
              "type": "number"
            }
          },
          "lods": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/lod"
            }
          }
        }
      }
    },
    "featureIndex": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "featureId",
          "renderId",
          "kind",
          "sourceIds",
          "chunkIds",
          "provenance"
        ],
        "properties": {
          "featureId": {
            "type": "string"
          },
          "renderId": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string"
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "chunkIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provenance": {
            "type": "object"
          }
        }
      }
    }
  }
}
