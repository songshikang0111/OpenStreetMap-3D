{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://city-ink.local/schemas/tileset.schema.json",
  "title": "City Ink 3D tileset metadata (tileset.json)",
  "description": "Schema version 1. Mirrors validateTileset in packages/tiles; see docs/phase2/02-tile-format.md section 4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "tiles", "bounds", "center", "levels", "coverage", "generator", "layers", "source", "attribution", "ground"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "tiles": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "pattern": "\\{z\\}.*\\{x\\}.*\\{y\\}" } },
    "bounds": {
      "description": "[west, south, east, north] in degrees; west < east (no antimeridian crossing), latitudes within ±80.",
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -80, "maximum": 80 },
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -80, "maximum": 80 }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "center": { "description": "[lng, lat, zoom], inside bounds.", "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "description": "Ordered by increasing zoom.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "zoom", "profile", "geometricErrorMeters"],
        "properties": {
          "id": { "type": "string", "pattern": "^L\\d+$" },
          "zoom": { "type": "integer", "minimum": 0, "maximum": 22 },
          "profile": { "enum": ["massing", "full"] },
          "geometricErrorMeters": { "type": "number", "minimum": 0 }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zoom", "index"],
      "properties": { "zoom": { "type": "integer", "minimum": 0, "maximum": 22 }, "index": { "type": "string", "minLength": 1 } }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "compatibleRuntime"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
        "compatibleRuntime": { "type": "string", "minLength": 1 }
      }
    },
    "layers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" } },
    "attributes": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["osm-pbf", "osm-json", "project", "synthetic"] },
        "file": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "timestamp": { "type": "string" }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "url", "license"],
      "properties": { "text": { "type": "string", "minLength": 1 }, "url": { "type": "string", "pattern": "^https?://" }, "license": { "type": "string", "minLength": 1 } }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "options": { "type": "object" }, "configHash": { "type": "string" } }
    },
    "ground": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elevation", "value"],
      "properties": { "elevation": { "const": "flat" }, "value": { "const": 0 } }
    },
    "terrain": { "description": "Reserved for DEM terrain (M6); must be null in schema version 1.", "type": "null" },
    "heightSources": { "description": "Reserved for external height datasets (M6).", "type": "array", "maxItems": 0 },
    "extensions": { "type": "object" }
  }
}
