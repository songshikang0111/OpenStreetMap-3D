{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://city-ink.local/schemas/landmark-recipe.schema.json",
  "title": "City Ink landmark recipe v1",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "generator", "engineCompatibility", "match", "anchor", "orientation", "parameters", "materialRoles", "source", "provenance"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generator": {"type": "string", "minLength": 1},
    "engineCompatibility": {"type": "string", "minLength": 1},
    "priority": {"type": "number"},
    "match": {"type": "object", "required": ["osm"], "properties": {
      "osm": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "required": ["type", "id"], "properties": {"type": {"enum": ["node", "way", "relation"]}, "id": {"type": "integer", "minimum": 1}}}},
      "bounds": {"type": "object", "required": ["south", "west", "north", "east"], "properties": {"south": {"type": "number", "minimum": -90, "maximum": 90}, "north": {"type": "number", "minimum": -90, "maximum": 90}, "west": {"type": "number", "minimum": -180, "maximum": 180}, "east": {"type": "number", "minimum": -180, "maximum": 180}}}
    }},
    "anchor": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "source-footprint"}}},
    "orientation": {"type": "object", "required": ["kind", "radians"], "properties": {"kind": {"const": "source"}, "radians": {"const": 0}}},
    "parameters": {"type": "object"},
    "materialRoles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source": {"type": "object"},
    "provenance": {"type": "object"}
  }
}
