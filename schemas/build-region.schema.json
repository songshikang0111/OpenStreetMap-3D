{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "City Ink GeoJSON build region",
  "oneOf": [
    { "$ref": "#/$defs/geometry" },
    { "type": "object", "required": ["type","geometry"], "properties": {
      "type": { "const": "Feature" }, "geometry": { "$ref": "#/$defs/geometry" }
    }}
  ],
  "$defs": {
    "position": { "type": "array", "minItems": 2, "prefixItems": [
      { "type":"number","minimum":-180,"maximum":180 },
      { "type":"number","minimum":-80,"maximum":80 }
    ], "items": {"type":"number"} },
    "ring": { "type":"array", "minItems":4, "items": {"$ref":"#/$defs/position"}, "description":"The first and last positions must coincide." },
    "polygon": { "type":"array", "minItems":1, "items":{"$ref":"#/$defs/ring"} },
    "geometry": {
      "type":"object","required":["type","coordinates"],
      "oneOf":[
        {"properties":{"type":{"const":"Polygon"},"coordinates":{"$ref":"#/$defs/polygon"}}},
        {"properties":{"type":{"const":"MultiPolygon"},"coordinates":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/polygon"}}}}
      ]
    }
  }
}
