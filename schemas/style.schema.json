{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://city-ink.local/schemas/style.schema.json",
  "title": "City Ink style pack metadata v1 (factories are trusted ESM exports)",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "engineCompatibility",
    "styleContractVersion",
    "parametersSchema",
    "materialRoles",
    "fallbackRole",
    "rebuildParameters",
    "qualityHints"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "styleContractVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "engineCompatibility": {
      "type": "string",
      "minLength": 1
    },
    "parametersSchema": {
      "type": "object",
      "required": [
        "type",
        "properties",
        "additionalProperties"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "object"
        },
        "additionalProperties": {
          "const": false
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/parameterRule"
          }
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "$comment": "Only optional number/integer/boolean/string properties are supported. Runtime also requires finite numbers, ordered/inhabited numeric bounds and enum/default values consistent with type, bounds and enum. Defaults apply only to omitted keys; explicit null/undefined values are invalid. Integers use JavaScript safe integer precision."
    },
    "materialRoles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "fallbackRole": {
      "type": "string"
    },
    "rebuildParameters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qualityHints": {
      "type": "object"
    }
  },
  "$defs": {
    "parameterRule": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "number"
            },
            "default": {
              "type": "number"
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "number"
              }
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "integer"
            },
            "default": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "boolean"
              }
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "string"
            },
            "default": {
              "type": "string"
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
