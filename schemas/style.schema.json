{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://city-ink.local/schemas/style.schema.json",
  "title": "City Ink style pack metadata v1 (factories are trusted ESM exports)",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "engineCompatibility", "styleContractVersion", "parametersSchema", "materialRoles", "fallbackRole", "rebuildParameters", "qualityHints"],
  "properties": {
    "schemaVersion": {"const": 1}, "styleContractVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "engineCompatibility": {"type": "string", "minLength": 1},
    "parametersSchema": {"type": "object", "required": ["type", "properties", "additionalProperties"], "properties": {"type": {"const": "object"}, "additionalProperties": {"const": false}, "properties": {"type": "object"}}},
    "materialRoles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "fallbackRole": {"type": "string"},
    "rebuildParameters": {"type": "array", "items": {"type": "string"}},
    "qualityHints": {"type": "object"}
  }
}
