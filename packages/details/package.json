{
  "name": "@city-ink/details",
  "version": "0.0.0",
  "description": "Optional street furniture, traffic and site-completion decorations for City Ink",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.11"
  },
  "dependencies": {
    "@city-ink/generators": "0.0.0"
  }
}
