{
  "name": "@city-ink/map",
  "version": "0.0.0",
  "description": "Map-style browser SDK that streams City Ink tiles into a Three.js scene or a MapLibre layer",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./maplibre": {
      "types": "./dist/maplibre/index.d.ts",
      "import": "./dist/maplibre/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.11"
  },
  "dependencies": {
    "@city-ink/tiles": "0.0.0",
    "@city-ink/generators": "0.0.0"
  },
  "peerDependencies": {
    "three": ">=0.186.0 <0.187.0",
    "maplibre-gl": ">=6.16.0 <7.0.0"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    }
  }
}
