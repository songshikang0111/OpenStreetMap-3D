{
  "name": "@city-ink/styles",
  "version": "1.0.0",
  "type": "module",
  "description": "City Ink StyleSpec, default styles (plain, light, dark), the procedural facade shader and semantic style packs",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./spec": {
      "types": "./spec.d.ts",
      "import": "./spec.js"
    },
    "./defaults": {
      "types": "./defaults.d.ts",
      "import": "./defaults.js"
    },
    "./facade-shader": {
      "types": "./facade-shader.d.ts",
      "import": "./facade-shader.js"
    },
    "./cel": {
      "types": "./cel.d.ts",
      "import": "./cel.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "spec.js",
    "spec.d.ts",
    "defaults.js",
    "defaults.d.ts",
    "facade-shader.js",
    "facade-shader.d.ts",
    "cel.js",
    "cel.d.ts",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "three": ">=0.186.0 <0.187.0"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false
